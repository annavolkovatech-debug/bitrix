# ===== Bitrix24 (Международный) =====
# Исходящий вебхук (полный URL вида https://your-port.bitrix24.com/rest/{user_id}/{webhook_token}/)
BITRIX_WEBHOOK_URL=https://your-port.bitrix24.com/rest/1/xxxxxxxxxxxxxxxx/
BITRIX_BASE_URL=https://your-port.bitrix24.com/rest/1/xxxxxxxxxxxxxxxx/
# Секрет inbound (?secret=... в URL нашего /api/bitrix/webhook)
BITRIX_INBOUND_SECRET=change_me
# «Токен приложения» в настройках Исходящего вебхука Битрикс
BITRIX_OUTBOUND_APP_TOKEN=change_me

# ===== REGNUM (поиск авто по госномеру) =====
# Документация: http://drm.bovsoft.com:400/bovsoft.regnum.clientapi?id=467&tocken=8559856c3c0b59d8ab6c7f95742d2869
REGNUM_BASE_URL=http://drm.bovsoft.com:400/bovsoft.regnum.clientapi
REGNUM_ID=467
REGNUM_CLIENT_ID=467
REGNUM_TOKEN=8559856c3c0b59d8ab6c7f95742d2869

# ===== Moloni (https://www.moloni.pt/dev) =====
MOLONI_BASE_URL=https://api.moloni.pt/v1
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_USERNAME=
MOLONI_PASSWORD=
# company_id можно взять из /companies/getAll после авторизации
MOLONI_COMPANY_ID=

# ===== Общее =====
ALLOWED_ORIGIN=*
# Порталы, с которых разрешены прямые вызовы фронта Bitrix
BITRIX_PORTAL=your-port.bitrix24.com
# Для доверия self-signed certs локально:
NODE_TLS_REJECT_UNAUTHORIZED=0
